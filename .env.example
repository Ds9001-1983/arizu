# =====================================================================
# ARIZU — Umgebungsvariablen
#
# Die Seite ist bewusst ohne jede dieser Variablen lauffähig: Ohne SMTP
# läuft der Mail-Demo-Modus (Logging), ohne DATABASE_URL landen Leads nur
# per Mail, ohne Admin-Hash bleibt /intern gesperrt. So kann der Prototyp
# ohne Secrets gebaut und deployt werden.
#
# NACH JEDER ÄNDERUNG NEU BAUEN. Next.js löst `process.env.…` schon beim
# Build auf und schreibt die Werte in die Server-Bundles. `npm run start`
# liest sie danach NICHT mehr aus der Umgebung — ein blosser Neustart oder
# ein `export VAR=…` bleibt wirkungslos, und der Fehler sieht aus wie ein
# falsches Passwort. `npm run dev` ist davon nicht betroffen.
# Auf Vercel entspricht das dem Redeploy nach dem Setzen einer Variable.
# =====================================================================

# --- Mailversand (SMTP des Hosting-Pakets) ---------------------------
# Läuft über den externen Mailserver, nicht über Vercel. Wichtig fürs DNS:
# MX, SPF und DKIM müssen beim Mailhost bleiben, nur A/CNAME zeigen auf Vercel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ARIZU Gebäudedienstleistungen <info@arizu-gebaeudedienstleistungen.de>"

# Empfänger der Anfrage-Benachrichtigung. Ohne Angabe: business.email.
LEAD_TO=

# Logo in den HTML-Mails. Seit dem 14.08.2026 leer zu lassen: Die Domain ist
# registriert und liefert das Bild aus, der Rückfall auf SITE_URL greift also
# von selbst — auch aus Vorschau-Deployments heraus, weil die URL öffentlich
# ist. Nur setzen, wenn das Logo einmal woanders liegen soll.
MAIL_LOGO_URL=

# --- Lead-Speicher (Neon Postgres) -----------------------------------
# Nach dem Setzen einmal `npm run db:init` ausführen.
#
# ZWEI Datenbanken, beide bei Neon in eu-central-1 (Frankfurt):
#   arizu-leads-eu  — Produktion, echte Anfragen. Nur in Vercel gesetzt.
#   arizu-test-eu   — Preview und lokale Entwicklung. Gehört hier hinein.
#
# Der Grund ist `npm run qa`: Die Suite schickt echte Anfragen durch die
# Formulare. Mit einer gemeinsamen Datenbank tauchten die Testzeilen in
# Arians Anfragenliste auf, und eine Preisänderung, die man in einer
# Vorschau ausprobiert, schlüge sofort auf die Live-Seite durch.
DATABASE_URL=

# --- Interner Bereich /intern ----------------------------------------
# Hash erzeugen mit: npm run hash:password "<passwort>"
#
# ACHTUNG: In dieser Datei müssen die Dollarzeichen des Hashes escaped werden
# (pbkdf2\$210000\$…). Next.js liest .env über dotenv-expand, dort wäre
# `$210000` eine Variablenreferenz und würde zu Leerstring — der Login sagt
# dann "Passwort stimmt nicht" und man sucht ewig. Anführungszeichen helfen
# nicht. In Vercel dagegen den Rohwert eintragen, dort gibt es keine
# Expansion. `npm run hash:password` gibt beide Varianten aus.
ARIZU_ADMIN_PASSWORD_HASH=
# Zufälliger, langer Wert. Wechselt man ihn, sind alle Sitzungen ungültig.
SESSION_SECRET=
